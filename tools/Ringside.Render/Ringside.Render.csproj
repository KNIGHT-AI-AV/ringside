<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders README images and GIF frames from the real UI, with no window on screen. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Ringside.Render</AssemblyName>
    <RootNamespace>Ringside.Render</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ringside\Ringside.csproj" />
  </ItemGroup>

</Project>
