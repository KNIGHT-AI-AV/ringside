<Window x:Class="Ringside.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ringside"
        Title="Welcome to Ringside" Icon="pack://application:,,,/ringside.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" FontFamily="{StaticResource UiFont}">
  <Grid Margin="18">
    <Border CornerRadius="18" Background="#16161A" Effect="{StaticResource CardShadow}"/>
    <Border CornerRadius="18" BorderThickness="1" Background="{StaticResource CardFill}" BorderBrush="{StaticResource CardEdge}">
      <StackPanel Width="400" Margin="28,22,28,26">
        <Grid MouseLeftButtonDown="OnDrag" Background="Transparent">
          <StackPanel Orientation="Horizontal">
            <Grid Width="30" Height="30">
              <local:Ring Thickness="3.5" Value="72" Stroke="{x:Static local:Theme.ClaudeAccent}" Track="{StaticResource TrackBrush}"/>
              <local:Ring Width="16" Height="16" Thickness="3.5" Value="46" Stroke="{x:Static local:Theme.CodexAccent}" Track="{StaticResource TrackBrush}"/>
            </Grid>
            <TextBlock Text="Ringside" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Fg1}" Margin="10,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" HorizontalAlignment="Right" ToolTip="Close" Click="OnClose"/>
        </Grid>

        <TextBlock Text="Welcome to Ringside" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Fg1}" Margin="0,22,0,0"/>
        <TextBlock Style="{StaticResource Hint}" FontSize="12.5" LineHeight="19" Margin="0,8,0,0"
                   Text="Your Claude Code and Codex limits, always in view. Ringside reads the usage numbers your apps already keep on this PC. It never reads your login and never sends your usage anywhere."/>

        <TextBlock Style="{StaticResource SectionLabel}" Text="FOUND ON THIS PC" Margin="0,22,0,4"/>
        <Border CornerRadius="10" Background="#0BFFFFFF" Padding="14,4">
          <StackPanel>
            <Grid Margin="0,7">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="#D97757" VerticalAlignment="Center" Margin="0,1,9,0"/>
                <TextBlock Text="Claude desktop app" FontSize="12.5" Foreground="{StaticResource Fg1}"/>
              </StackPanel>
              <TextBlock x:Name="DesktopStatus" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource Fg2}"/>
            </Grid>
            <Grid Margin="0,7">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="#D97757" VerticalAlignment="Center" Margin="0,1,9,0"/>
                <TextBlock Text="Claude Code" FontSize="12.5" Foreground="{StaticResource Fg1}"/>
              </StackPanel>
              <TextBlock x:Name="CodeStatus" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource Fg2}"/>
            </Grid>
            <Grid Margin="0,7">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="#19C39C" VerticalAlignment="Center" Margin="0,1,9,0"/>
                <TextBlock Text="Codex" FontSize="12.5" Foreground="{StaticResource Fg1}"/>
              </StackPanel>
              <TextBlock x:Name="CodexStatus" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource Fg2}"/>
            </Grid>
          </StackPanel>
        </Border>
        <TextBlock x:Name="NothingFound" Style="{StaticResource Hint}" Margin="0,8,0,0" Visibility="Collapsed"
                   Text="Nothing yet. Ringside fills in on its own as soon as one of these apps runs."/>

        <TextBlock Style="{StaticResource SectionLabel}" Text="SETUP" Margin="0,22,0,2"/>
        <CheckBox x:Name="HookToggle" Style="{StaticResource Toggle}">
          <StackPanel>
            <TextBlock Text="Exact Claude reset times" Foreground="{StaticResource Fg1}"/>
            <TextBlock x:Name="HookNote" Style="{StaticResource Hint}" Margin="0,2,0,0"
                       Text="Adds a small status line hook to Claude Code. Any status line you already use keeps working, and you can remove it in Settings."/>
          </StackPanel>
        </CheckBox>
        <CheckBox x:Name="StartupToggle" Style="{StaticResource Toggle}" IsChecked="True">
          <TextBlock Text="Start with Windows" Foreground="{StaticResource Fg1}"/>
        </CheckBox>
        <CheckBox x:Name="UpdatesToggle" Style="{StaticResource Toggle}" IsChecked="True">
          <StackPanel>
            <TextBlock Text="Check for updates" Foreground="{StaticResource Fg1}"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                       Text="Asks GitHub for new versions now and then. Nothing about your usage leaves your PC."/>
          </StackPanel>
        </CheckBox>

        <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="Start Ringside" HorizontalAlignment="Stretch"
                Margin="0,24,0,0" Click="OnStart" IsDefault="True"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
