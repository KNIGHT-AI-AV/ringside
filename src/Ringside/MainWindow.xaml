<Window x:Class="Ringside.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ringside"
        Title="Ringside"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual" Left="-10000" Top="-10000"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}">

  <!-- The 18 px gutter is room for the soft shadow. -->
  <Grid x:Name="Root" Margin="18" Opacity="0"
        MouseLeftButtonDown="OnMouseDown" MouseRightButtonUp="OnRightClick"
        MouseEnter="OnEnter" MouseLeave="OnLeave">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="Slide" Y="8"/>
    </Grid.RenderTransform>

    <Border x:Name="CardShadow" CornerRadius="16" Background="#16161A" Effect="{StaticResource CardShadow}"/>

    <Border x:Name="Card" CornerRadius="16" BorderThickness="1" Padding="16,14,16,14"
            Background="{StaticResource CardFill}" BorderBrush="{StaticResource CardEdge}">
      <Grid>
        <StackPanel x:Name="FullPanel" Width="262">
          <local:ProviderView x:Name="ClaudeView"/>
          <Rectangle x:Name="Divider" Height="1" Fill="{StaticResource Hairline}" Margin="0,13,0,13"/>
          <local:ProviderView x:Name="CodexView"/>
          <TextBlock x:Name="HintText" Margin="0,12,0,0" FontSize="10.5" Foreground="{StaticResource Fg3}"
                     TextWrapping="Wrap" Visibility="Collapsed"
                     Text="Drag to move. Double-click for compact.&#10;Right-click for the menu and settings."/>
        </StackPanel>

        <StackPanel x:Name="PillPanel" Orientation="Horizontal" Visibility="Collapsed">
          <StackPanel x:Name="PillA" Orientation="Horizontal">
            <local:Ring x:Name="PillRingA" Width="18" Height="18" Thickness="3" Track="{StaticResource TrackBrush}" VerticalAlignment="Center"/>
            <TextBlock VerticalAlignment="Center" Margin="7,0,0,0" Typography.NumeralAlignment="Tabular"><Run Text="Claude " FontSize="11" Foreground="{StaticResource Fg2}"/><Run x:Name="PillPctA" Text="-" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Fg1}"/></TextBlock>
          </StackPanel>
          <StackPanel x:Name="PillB" Orientation="Horizontal" Margin="14,0,0,0">
            <local:Ring x:Name="PillRingB" Width="18" Height="18" Thickness="3" Track="{StaticResource TrackBrush}" VerticalAlignment="Center"/>
            <TextBlock VerticalAlignment="Center" Margin="7,0,0,0" Typography.NumeralAlignment="Tabular"><Run Text="Codex " FontSize="11" Foreground="{StaticResource Fg2}"/><Run x:Name="PillPctB" Text="-" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Fg1}"/></TextBlock>
          </StackPanel>
        </StackPanel>

        <Border x:Name="Controls" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-8,0"
                Padding="2" CornerRadius="8" Background="#1E1E23" Opacity="0" IsHitTestVisible="False">
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" Click="OnSettingsClick"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Compact (or double-click)" Click="OnCompactClick"/>
            <Button x:Name="PinButton" Style="{StaticResource IconButton}" Click="OnPinClick"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="Hide (the tray icon brings it back)" Click="OnHideClick"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
